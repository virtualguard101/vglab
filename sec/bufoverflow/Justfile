# bof-lab —— 缓冲区溢出实验构建 / 演示脚本
#
# 关键：各阶段用“互相矛盾”的编译标志，这本身就是教学内容。
#   脆弱目标 (part3) 必须关掉所有现代防御，攻击 (part4) 才打得通；
#   防御阶段 (part5/canary) 再把防御逐个打开，对照观察。
#
# 用法：
#   just            列出所有命令
#   just build      编译全部靶子与工具到 build/
#   just demo       从头到尾跑一遍完整攻击链（无需手动输地址）
#   just defense    演示四层防御如何逐一拦截同一发 payload
#   just clean      清空 build/

src := "src"
build := "build"
cc := "gcc"

# 脆弱构建标志：关 canary, 非 PIE, 栈可执行
vuln_flags := "-O0 -g -fno-stack-protector -no-pie -z execstack -Wno-deprecated-declarations"
# 工具(攻击端)：正常构建, 它不是被攻击对象
tool_flags := "-O2 -Wall"

default:
    @just --list

# ---- 编译 ----

_mkbuild:
    @mkdir -p {{build}}

build: _mkbuild
    {{cc}} {{vuln_flags}} {{src}}/concepts/unsafe.c -o {{build}}/unsafe
    {{cc}} -O0 -g -fstack-protector-all {{src}}/concepts/unsafe.c -o {{build}}/unsafe_canary -Wno-deprecated-declarations
    {{cc}} {{vuln_flags}} {{src}}/concepts/dissect.c -o {{build}}/dissect
    {{cc}} {{vuln_flags}} {{src}}/vulnerable.c -o {{build}}/vulnerable
    {{cc}} {{tool_flags}} {{src}}/exploit.c -o {{build}}/exploit
    {{cc}} -O0 -g -fstack-protector-strong {{src}}/defense.c -o {{build}}/defense -Wno-deprecated-declarations
    {{cc}} -O0 -g -fstack-protector-all {{src}}/canary_probe.c -o {{build}}/canary_probe
    {{cc}} -O0 -g -fno-stack-protector {{src}}/canary_probe.c -o {{build}}/canary_probe_off


# ---- 演示 ----

unsafe mode:
    ./{{build}}/unsafe {{ mode }}

# 看栈布局 + 改返回地址跳过一条语句
dissect:
    ./{{build}}/dissect layout
    @echo
    -DISSECT_MODE=redirect ./{{build}}/dissect

# 目标在泄露模式下自曝地址(真实攻击靠泄露/爆破获得)
leak:
    VULN_DEBUG=1 ./{{build}}/vulnerable test

# 完整攻击链: 关闭 ASLR(基于 setarch) 并运行攻击程序, 用泄露地址打开 shell 并运行单条命令
exploit:
    @echo "========================= payload layout =========================="
    ./{{build}}/exploit -x
    @echo
    @echo "======= Auto Exploit: fork/exec target, and check shell pop ======="
    # -./{{build}}/exploit -z -t {{build}}/vulnerable
    -setarch $(uname -m) -R ./{{build}}/exploit -z -t {{build}}/vulnerable -v

# 基于攻击程序获取交互式 shell
getshell addr_offset:
    setarch $(uname -m) -R ./build/exploit -o {{ addr_offset }} -t build/vulnerable

# 05：防御演示: 同一发超长输入打到安全版本上, 四层现代防御各自的反应
defense:
    @echo "===== Source Code Layer ====="
    @python3 -c "print('A'*300)" | { read s; \
      ./{{build}}/defense 1 "$s"; ./{{build}}/defense 2 "$s"; ./{{build}}/defense 3 "$s"; }
    @echo
    @echo "======= Compiler Layer ======"
    -./{{build}}/canary_probe smash 200
    @echo
    @echo "======= Without Canary ======"
    -./{{build}}/canary_probe_off smash 200
    @echo
    @echo "==== Randomness of Canary ==="
    ./{{build}}/canary_probe show
    ./{{build}}/canary_probe show

format:
    indent -npro -kr -i8 -ts8 -sob -l80 -ss -ncs -cp1 -il0 src/*.c src/concepts/*.c && rm -f src/*.c~ src/concepts/*.c~

clean:
    rm -rf {{build}}
