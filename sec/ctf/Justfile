image:
    docker build --network="host" -t pwnenv .

container:
    docker run \
    -d \
    -p "25000:22" \
    --name=pwn24 \
    -v ~/vg101/vglab/sec/ctf:/ctf \
    -e XDG_RUNTIME_DIR=/tmp \
    -e DISPLAY=$DISPLAY \
    -e WAYLAND_DISPLAY=$WAYLAND_DISPLAY \
    -v $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:/tmp/$WAYLAND_DISPLAY \
    -e QT_QPA_PLATFORM=wayland \
    pwnenv

cli:
    docker exec -w /ctf \
        -e TERM=xterm-256color \
        -u ubuntu \
        -it pwn24 \
        bash
